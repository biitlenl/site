---
import Project from "../components/card/Project.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/nav/Navbar.astro";
import Layout from "../layout/Layout.astro";

import PodnativeLogo from "../assets/logos/podnative.svg"
import AutomarkLogo from "../assets/logos/automark.svg"
import SimpledroidLogo from "../assets/logos/simpledroid.svg"
import JotLogo from "../assets/logos/jot.svg"
---

<Layout>
  <Navbar />
  <main class="2xl:w-5xl gap-4 flex flex-col">
    <h1 class="text-2xl md:text-4xl xl:text-6xl">
      Hey, we're <span class="bg-amber-400">biitle.nl</span> and we make some cool
      stuff.
    </h1>
    <section id="projects">
      <h2 class="text-4xl mb-4">Projects</h2>
      <div class="grid lg:grid-cols-2 gap-2">
        <Project
          href="/simpledroid"
          img={SimpledroidLogo}
          text="Simpledroid"
          css="gap-1 py-3 pr-3"
          bg="!bg-purple-500"
          textColor="text-white"
        />
        <Project
          href="/apps/podnative"
          img={PodnativeLogo}
          text="Podnative"
          css="gap-1 py-3 !bg-[#0E6BA8]"
          textColor="text-white"
        />
        <Project
          href="/extensions/automark"
          img={AutomarkLogo}
          text="Automark"
          css="gap-1 py-3 !bg-[#BA1B1D]"
          textColor="text-white"
        />
        <Project
          href="/apps/jot"
          img={JotLogo}
          text="Jot"
          css="gap-1 py-3 !bg-white"
          textColor="text-black"
        />
      </div>
    </section>
    <section id="about">
      <p class="text-lg">
        Hey! Welcome to our site.
        We host our projects and other things here.
        Above this section you should see a grid of projects.
        Click on any of them to see what they are! And below you can see links, our social media profiles, etc.
        <br>
        Thanks for visiting!
      </p>
    </section>
  </main>
  <Footer />
</Layout>
