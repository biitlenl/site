---
import Project from "../components/card/Project.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/nav/Navbar.astro";
import Layout from "../layout/Layout.astro";

import PodnativeLogo from "../assets/logos/podnative.svg"
import HexadecimalLogo from "../assets/logos/hexadecimal.svg"
import HexadecimalBackground from "../assets/backgrounds/hexadecimal.svg"
import LightswitchLogo from "../assets/logos/lightswitch.svg"
---

<Layout>
  <Navbar />
  <main class="2xl:w-5xl gap-4 flex flex-col">
    <h1 class="text-2xl md:text-4xl xl:text-6xl">
      Hey, we're <span class="bg-amber-400">biitle.nl</span> and we make some cool
      stuff.
    </h1>
    <section id="projects">
      <h2 class="text-4xl mb-4">Projects</h2>
      <div class="grid lg:grid-cols-3 gap-2">
        <Project
          href="/apps/lightswitch"
          img={LightswitchLogo}
          text="Lightswitch"
          css="gap-2 py-3 pr-3"
          bg="[#dc70df]"
          textColor="white"
        />
        <Project
          href="/apps/podnative"
          img={PodnativeLogo}
          text="Podnative"
          css="gap-1 py-3 !bg-[#0E6BA8]"
          textColor="white"
        />
        <Project
          href="/apps/hx"
          img={HexadecimalLogo}
          text="Hexadecimal"
          css={`gap-4 text-white py-3 bg-linear-to-b from-neutral-925 bg-cover to-neutral-950`}
          style={{ backgroundImage: `url(${HexadecimalBackground.src})` }}
          textColor="black"
        />
      </div>
    </section>
    <section id="about">
      <p class="text-lg">
        Hey! Welcome to our site.
        We host our projects and other things here.
        Above this section you should see a grid of projects.
        Click on any of them to see what they are! And below you can see links, our social media profiles, etc.
        <br>
        Thanks for visiting!
      </p>
    </section>
  </main>
  <Footer />
</Layout>
