---
import Image from "astro/components/Image.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/nav/Navbar.astro";
import Layout from "../layout/Layout.astro";

import ErrorPicture from '../assets/404.png'
---

<style>
  :global(body) {
    background: #0c0c0c;
    color: white;
  }
</style>
<Layout>
  <Navbar />
  <main class="2xl:w-5xl gap-4 flex flex-col">
    <a href="/">
      <Image src={ErrorPicture} alt="There's supposed to be a 404 error here. Nonetheless, click to go back home" width=1423 height=1002 loading="eager" />
    </a>
  </main>
  <Footer />
</Layout>
