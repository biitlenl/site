---
import Image from "astro/components/Image.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/nav/Navbar.astro";
import Layout from "../layout/Layout.astro";
---

<style>
  body {
    background: #0c0c0c !important;
    color: white !important;
  }
</style>
<Layout>
  <Navbar />
  <main class="2xl:w-5xl gap-4 flex flex-col">
    <a href="/">
      <Image src="/assets/404.png" alt="There's supposed to be a 404 error here. Nonetheless, click to go back home" width=949 height=668 loading="eager" />
    </a>
  </main>
  <Footer />
</Layout>
