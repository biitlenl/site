---
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/nav/Navbar.astro";
import Tagbar from "../../components/tags/Tagbar.astro";
import GithubTag from "../../components/tags/GithubTag.astro";
import Layout from "../../layout/Layout.astro";
import WorkInProgress from "../../components/tags/WorkInProgress.astro";
import Image from "astro/components/Image.astro";
---

<Layout title="Caffeine · biitle.nl" metaTitle="Caffeine" description="Keep your screen on!" url="https://biitle.nl/simpledroid/caffeine">
  <Navbar />
  <main class="2xl:w-5xl gap-4 flex flex-col items-center">
    <Image src="/assets/logos/caffeine.svg" alt="Caffeine Logo" class="w-24 self-center bg-[#281D1D] p-2 rounded-full" width=96 height=96 loading="eager" />
    <h1 class="text-2xl md:text-4xl xl:text-6xl text-center">
      Caffeine
    </h1>
    <h2 class="text-2xl text-center">Keep your screen on!</h2>
    <Tagbar>
      <WorkInProgress />
      <GithubTag repo="simpledroid/caffeine" />
    </Tagbar>
    <Image src="/apps/caffeine/screenshot.png" class="w-72" alt="Screenshot" width=148 height=280 loading="eager" />
    
    <!-- <a href="https://play.google.com/store/apps/details?id=nl.biitle.caffeine">
      <Image src="/assets/badges/gplay.svg" alt="Get it on Google Play" width=300 height=89 class="h-16" loading="eager" />
    </a> -->
  </main>
  <Footer />
</Layout>
