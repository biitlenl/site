---
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/nav/Navbar.astro";
import GithubTag from "../../components/tags/GithubTag.astro";
import Tagbar from "../../components/tags/Tagbar.astro";
import WorkInProgress from "../../components/tags/WorkInProgress.astro";
import Layout from "../../layout/Layout.astro";
---

<Layout title="Podnative · biitle.nl" metaTitle="Podnative" description="Podcasts. On your wrist." url="https://biitle.nl/simpledroid/podnative">
  <Navbar />
  <main class="2xl:w-5xl gap-4 flex flex-col items-center">
    <img src="/assets/logos/podnative.svg" alt="Podnative Logo" class="w-24 self-center bg-[#0E6BA8] p-2 rounded-full">
    <h1 class="text-2xl md:text-4xl xl:text-6xl text-center">
      Podnative
    </h1>
    <h2 class="text-2xl  text-center">Podcasts. On your wrist.</h2>
    <Tagbar>
      <WorkInProgress />
      <GithubTag repo="simpledroid/podnative" />
    </Tagbar>
    <img src="/apps/podnative/list.png" width=384 height=384 class="w-96" alt="Screenshot">
    
    <!-- <a href="https://play.google.com/store/apps/details?id=nl.biitle.podnative">
      <img src="/assets/badges/gplay.svg" alt="Get it on Google Play" class="h-16">
    </a> -->
  </main>
  <Footer />
</Layout>
