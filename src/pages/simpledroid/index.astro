---
import Image from "astro/components/Image.astro";
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/nav/Navbar.astro";
import Layout from "../../layout/Layout.astro";

import SimpledroidLogo from "../../assets/logos/simpledroid.svg"
---

<Layout title="Simpledroid" metaTitle="Simpledroid" description="Simple apps that get the job done" url="https://biitle.nl/simpledroid">
  <Navbar />
  <main class="2xl:w-5xl gap-4 flex flex-col">
    <Image src={SimpledroidLogo} alt="Simpledroid Logo" class="w-24 self-center bg-purple-500 p-2 rounded-xl" width=96 height=96 loading="eager" />
    <h1 class="text-2xl md:text-4xl xl:text-6xl text-center">
      Simpledroid
    </h1>
    <h2 class="text-2xl mb-4 text-center">Simple apps that get the job done</h2>
    <section id="projects">
      <h2 class="text-4xl mb-4">Projects</h2>
      <div class="grid md:grid-cols-1 gap-2">
        <p class="text-center project from-[#140325] to-purple-950 xl:text-2xl md:py-20 bg-linear-to-b text-white">There are no projects here, yet.</p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
