---
import Image from "astro/components/Image.astro";
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/nav/Navbar.astro";
import Layout from "../../layout/Layout.astro";

import LightswitchLogo from "../../assets/logos/lightswitch.svg"
import LightswitchScreenshot from "../../assets/apps/lightswitch.png"
---

<style>
  :global(body) {
    background-color: oklch(92.541% 0.05383 316.273);
    color: black;
  }

  main {
    font-family: var(--font-roboto);
  }

  :global(*::selection) {
    background-color: oklch(70.876% 0.19056 326.32);
  }
</style>

<Layout title="Lightswitch · biitle.nl" metaTitle="Lightswitch" description="The missing wear client for Toggl Track" url="https://biitle.nl/apps/lightswitch">
  <Navbar />
  <main class="2xl:w-5xl gap-4 flex flex-col items-center">
    <Image src={LightswitchLogo} alt="Lightswitch Logo" class="w-24 self-center bg-[#dc70df] p-2 rounded-full" width=96 height=96 loading="eager" />
    <h1 class="text-2xl md:text-4xl xl:text-6xl text-center">Lightswitch</h1>
    <h2 class="text-2xl  text-center">The missing wear client for Toggl Track</h2>
    <Image src={LightswitchScreenshot} width=1152 height=1152 class="w-3xl aspect-square" alt="Screenshot" loading="eager" />
    
    <!-- <a href="https://play.google.com/store/apps/details?id=nl.biitle.podnative">
      <Image src="/assets/badges/gplay.svg" alt="Get it on Google Play" width=300 height=89 class="h-16" loading="eager" />
    </a> -->
  </main>
  <Footer />
</Layout>
