---
import { Font } from 'astro:assets';

import Image from "astro/components/Image.astro";
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/nav/Navbar.astro";
import Tagbar from "../../components/tags/Tagbar.astro";
import WorkInProgress from "../../components/tags/WorkInProgress.astro";
import Layout from "../../layout/Layout.astro";

import AutomarkLogo from "../../assets/logos/automark.svg"
import AutomarkScreenshot from "../../assets/apps/automark/image.png"
---

<Font cssVariable='--font-slabo' preload />

<style>
  body {
    background-color: white;
  }

  main {
      font-family: var(--font-slabo);
  }
</style>

<Layout title="Automark · biitle.nl" metaTitle="Automark for Instapaper" description="Bring your bookmarks into Instapaper" url="https://biitle.nl/extensions/automark">
  <Navbar />
  <main class="2xl:w-5xl gap-4 flex flex-col items-center">
    <Image src={AutomarkLogo} alt="Automark Logo" class="w-24 self-center bg-[#BA1B1D] p-2 rounded-full" width=96 height=96 loading="eager" />
    <h1 class="text-2xl md:text-4xl xl:text-6xl text-center">
      Automark
    </h1>
    <h2 class="text-2xl  text-center">Bring your bookmarks into Instapaper.</h2>

    <Tagbar>
      <WorkInProgress />
    </Tagbar>

    <p>Automark automatically saves bookmarks from selected folders into Instapaper.</p>
    
    <Image src={AutomarkScreenshot} class="w-72" alt="Screenshot" width=342 height=687 loading="eager" />
  </main>
  <Footer />
</Layout>
