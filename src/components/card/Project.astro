---
import Image from "astro/components/Image.astro";
const { href, img, text, css, textColor = 'black', bg = 'white' } = Astro.props;
---

<a class={`project ${css} ${textColor} ${bg}`} href={href}>
  <Image src={img} class="h-full" alt="Logo" width=56 height=56 loading="eager" />
  <h1 class="text-4xl">{text}</h1>
</a>
