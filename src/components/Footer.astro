---
import Image from "astro/components/Image.astro";
import Link from "./Link.astro";
import BiitleLogo from "../assets/logo.svg"

const year = new Date().getFullYear();
---

<footer class="2xl:w-4xl md:w-2xl sm:w-xl mt-16 mb-64 grid sm:grid-cols-4 grid-cols-2 gap-8 print:hidden">
  <div class="flex flex-col">
    <div class="flex items-center gap-2">
      <Image src={BiitleLogo} class="w-4 h-4" alt="biitle.nl Logo" width=24 height=24 loading="eager" />
      <h1>biitle.nl</h1>
    </div>

    <p>© {year} biitle.nl</p>
  </div>
  <div class="flex flex-col">
    <h1>Resources</h1>
    <Link href="/apps/lightswitch">Lightswitch</Link>
    <Link href="/apps/podnative">Podnative</Link>
    <Link href="/brandkit">Brand Kit</Link>
    <!-- <Link href="https://example.com">Backpack</Link> -->
    <!-- <p class="text-neutral-700">Nothing here.. yet!</p> -->
  </div>
  <div class="flex flex-col">
    <h1>Socials</h1>
    <Link href="mailto:contact@biitle.nl">E-mail</Link>
    <Link href="https://github.com/biitlenl">GitHub</Link>
    <Link href="https://blog.biitle.nl">Blog</Link>
  </div>
  <div class="flex flex-col">
    <h1>About</h1>
    <Link href="https://github.com/biitlenl/site/blob/main/README.md#contributing">Edit this page</Link>
    <Link href="https://github.com/biitlenl/site/">GitHub repo</Link>
  </div>
</footer>
